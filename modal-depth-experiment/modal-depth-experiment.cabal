cabal-version: 2.4
name: modal-depth-experiment
version: 0.1.0.0
build-type: Simple

executable modal-depth-experiment
    main-is: Main.hs
    hs-source-dirs: .
    other-modules:
        Evaluate
        Experiment
        Metrics
        Policy
        Scenario
        Types
    build-depends:
        base >=4.18 && <5,
        directory,
        filepath,
        process,
        time
    default-language: Haskell2010